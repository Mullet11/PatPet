<UserControl x:Class="PatPet.Views.Controls.DeadlinePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ToggleButton x:Name="Toggle" Style="{StaticResource ChipToggle}" ToolTip="Atur deadline">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,0,5,0"
                           VerticalAlignment="Center" Foreground="{Binding Foreground, ElementName=Toggle}" />
                <TextBlock x:Name="LabelText" FontSize="11" VerticalAlignment="Center"
                           Foreground="{Binding Foreground, ElementName=Toggle}" />
            </StackPanel>
        </ToggleButton>

        <Popup x:Name="Pop" PlacementTarget="{Binding ElementName=Toggle}" Placement="Bottom" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade"
               IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}">
            <Border Background="#FF22232C" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12" Padding="8" Margin="0,4,0,0">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,6">
                        <Button Style="{StaticResource Chip}" Content="Hari ini" Click="OnToday" />
                        <Button Style="{StaticResource Chip}" Content="Besok" Click="OnTomorrow" />
                        <Button Style="{StaticResource Chip}" Content="+1 minggu" Click="OnNextWeek" />
                    </WrapPanel>
                    <Calendar x:Name="Cal" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Jam" Style="{StaticResource Label}" Margin="0,0,8,0" />
                        <TextBox x:Name="TimeBox" Grid.Column="1" Style="{StaticResource InputBox}" MaxLength="5"
                                 TextAlignment="Center" Tag="HH:mm" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource TextButton}" Content="Hapus" Foreground="{StaticResource MutedBrush}" Click="OnClear" />
                            <Button Style="{StaticResource TextButton}" Content="Simpan" Click="OnSave" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="ErrorText" Style="{StaticResource Muted}" Foreground="{StaticResource DangerBrush}"
                               Visibility="Collapsed" Margin="0,4,0,0" Text="Tulis jam seperti 21:30" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
