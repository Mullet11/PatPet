<UserControl x:Class="PatPet.Views.Pages.ClockPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PatPet.Views.Controls">
    <StackPanel>
        <TextBlock Text="{Binding Clock.Greeting}" Style="{StaticResource Muted}" FontSize="12" />
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Clock.TimeText}" FontSize="38" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" />
            <TextBlock Text="{Binding Clock.ZoneLabel}" FontSize="12" FontWeight="Bold" Margin="8,0,0,9"
                       VerticalAlignment="Bottom" Foreground="{StaticResource AccentBrush}" />
        </StackPanel>
        <TextBlock Text="{Binding Clock.DateText}" Style="{StaticResource Label}" />

        <!-- daerah & cuaca -->
        <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="12" Background="{StaticResource SurfaceBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Clock.WeatherGlyph}" FontFamily="Segoe UI Symbol" FontSize="24"
                           Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{StaticResource WarnBrush}"
                           Visibility="{Binding Clock.HasWeather, Converter={StaticResource BoolToVis}}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding Clock.HasWeather, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Clock.TemperatureText}" Style="{StaticResource Label}" FontSize="15"
                                   FontWeight="SemiBold" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Clock.WeatherText}" Style="{StaticResource Muted}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Clock.WeatherText}" Style="{StaticResource Muted}"
                               Visibility="{Binding Clock.HasWeather, Converter={StaticResource BoolToVisInv}}" />
                    <TextBlock Text="{Binding Clock.LocationText}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE72C;" VerticalAlignment="Center"
                        ToolTip="Perbarui lokasi dan cuaca" Command="{Binding Clock.RefreshWeatherCommand}" />
            </Grid>
        </Border>

        <!-- kucing ekspresif, klik untuk mengelus -->
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <controls:SpriteAnimator x:Name="Pet" Scale="2" Cursor="Hand" ToolTip="Elus aku!"
                                     Animation="{Binding Pet.Animation}"
                                     PlayOnce="{Binding Pet.PlayOnce}"
                                     RestartToken="{Binding Pet.PlayToken}"
                                     CompletedCommand="{Binding Pet.AnimationCompletedCommand}" />
            <Border Margin="8,0,0,0" VerticalAlignment="Center" Padding="10,5" CornerRadius="10"
                    Background="{StaticResource SurfaceBrush}">
                <TextBlock Text="{Binding Pet.MoodText}" Style="{StaticResource Label}" />
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
