<UserControl x:Class="PatPet.Views.Pages.TimerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Arrow" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="18" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <!-- angka yang bisa diketik -->
        <Style x:Key="Digits" TargetType="TextBox" BasedOn="{StaticResource InputBox}">
            <Setter Property="Width" Value="62" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Padding" Value="0,1" />
            <Setter Property="MaxLength" Value="2" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        </Style>
        <Style x:Key="Colon" TargetType="TextBlock">
            <Setter Property="Text" Value=":" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="Margin" Value="4,0,4,18" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- alarm berbunyi -->
        <Border Panel.ZIndex="10" Background="{StaticResource CardBrush}"
                Visibility="{Binding Timer.IsAlarmRinging, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" FontSize="32" HorizontalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="Waktu habis!" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,2"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="{Binding Timer.DurationText, StringFormat=Timer {0} selesai}" Style="{StaticResource Muted}"
                           HorizontalAlignment="Center" />
                <Button Content="Matikan alarm" Margin="0,14,0,0" HorizontalAlignment="Center"
                        Style="{StaticResource AccentPill}" Command="{Binding Timer.StopAlarmCommand}" />
            </StackPanel>
        </Border>

        <!-- atur durasi -->
        <Grid Visibility="{Binding Timer.IsActive, Converter={StaticResource BoolToVisInv}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Ketik angka, klik panah, atau gulir mouse" Style="{StaticResource Muted}" HorizontalAlignment="Center" />

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                <StackPanel x:Name="HourSeg" Tag="h">
                    <Button Style="{StaticResource Arrow}" Content="&#xE70E;" Command="{Binding Timer.StepCommand}" CommandParameter="h+1" />
                    <TextBox Style="{StaticResource Digits}" Text="{Binding Timer.Hours, StringFormat={}{0:00}, UpdateSourceTrigger=LostFocus}" />
                    <Button Style="{StaticResource Arrow}" Content="&#xE70D;" Command="{Binding Timer.StepCommand}" CommandParameter="h-1" />
                    <TextBlock Text="jam" Style="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Center" />
                </StackPanel>
                <TextBlock Style="{StaticResource Colon}" />
                <StackPanel x:Name="MinSeg" Tag="m">
                    <Button Style="{StaticResource Arrow}" Content="&#xE70E;" Command="{Binding Timer.StepCommand}" CommandParameter="m+1" />
                    <TextBox Style="{StaticResource Digits}" Text="{Binding Timer.Minutes, StringFormat={}{0:00}, UpdateSourceTrigger=LostFocus}" />
                    <Button Style="{StaticResource Arrow}" Content="&#xE70D;" Command="{Binding Timer.StepCommand}" CommandParameter="m-1" />
                    <TextBlock Text="menit" Style="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Center" />
                </StackPanel>
                <TextBlock Style="{StaticResource Colon}" />
                <StackPanel x:Name="SecSeg" Tag="s">
                    <Button Style="{StaticResource Arrow}" Content="&#xE70E;" Command="{Binding Timer.StepCommand}" CommandParameter="s+1" />
                    <TextBox Style="{StaticResource Digits}" Text="{Binding Timer.Seconds, StringFormat={}{0:00}, UpdateSourceTrigger=LostFocus}" />
                    <Button Style="{StaticResource Arrow}" Content="&#xE70D;" Command="{Binding Timer.StepCommand}" CommandParameter="s-1" />
                    <TextBlock Text="detik" Style="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button Style="{StaticResource Chip}" Content="+1m" Command="{Binding Timer.AddMinutesCommand}" CommandParameter="1" />
                <Button Style="{StaticResource Chip}" Content="+5m" Command="{Binding Timer.AddMinutesCommand}" CommandParameter="5" />
                <Button Style="{StaticResource Chip}" Content="+10m" Command="{Binding Timer.AddMinutesCommand}" CommandParameter="10" />
                <Button Style="{StaticResource Chip}" Content="+30m" Command="{Binding Timer.AddMinutesCommand}" CommandParameter="30" />
                <Button Style="{StaticResource Chip}" Content="+1 jam" Command="{Binding Timer.AddMinutesCommand}" CommandParameter="60" />
                <Button Style="{StaticResource Chip}" Content="Reset" Foreground="{StaticResource MutedBrush}" Margin="0"
                        Command="{Binding Timer.ClearCommand}" />
            </WrapPanel>

            <Grid Grid.Row="3" VerticalAlignment="Bottom">
                <StackPanel VerticalAlignment="Center">
                    <CheckBox Content="Bunyikan alarm" IsChecked="{Binding Timer.AlarmEnabled}" />
                    <Button Style="{StaticResource TextButton}" HorizontalAlignment="Left" Margin="-9,0,0,0" Height="22"
                            Content="Dengar bunyinya" FontWeight="Normal" FontSize="11"
                            Command="{Binding Timer.TestAlarmCommand}" IsEnabled="{Binding Timer.AlarmEnabled}" />
                </StackPanel>
                <Button Style="{StaticResource AccentIconButton}" Content="&#xE768;" Width="44" Height="44" FontSize="16"
                        HorizontalAlignment="Right" ToolTip="Mulai" Command="{Binding Timer.StartPauseCommand}"
                        IsEnabled="{Binding Timer.CanStart}" />
            </Grid>
        </Grid>

        <!-- timer berjalan atau dijeda -->
        <StackPanel VerticalAlignment="Center" Visibility="{Binding Timer.IsActive, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Timer.StatusText}" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Timer.RemainingText}" FontSize="46" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{StaticResource TextBrush}" />
            <ProgressBar Height="5" Maximum="1" Margin="30,0,30,0" Value="{Binding Timer.Progress, Mode=OneWay}"
                         Foreground="{StaticResource AccentBrush}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <Button Style="{StaticResource IconButton}" Content="&#xE71A;" Width="36" Height="36"
                        ToolTip="Hentikan" Command="{Binding Timer.StopCommand}" />
                <Button Style="{StaticResource AccentIconButton}" Content="{Binding Timer.StartPauseGlyph}" Width="44" Height="44"
                        FontSize="16" Margin="12,0" ToolTip="Jeda atau lanjutkan" Command="{Binding Timer.StartPauseCommand}" />
                <Border Width="36" />
            </StackPanel>

            <WrapPanel HorizontalAlignment="Center" Margin="0,12,0,0">
                <Button Style="{StaticResource Chip}" Content="-5m" Command="{Binding Timer.AddMinutesCommand}" CommandParameter="-5" />
                <Button Style="{StaticResource Chip}" Content="-1m" Command="{Binding Timer.AddMinutesCommand}" CommandParameter="-1" />
                <Button Style="{StaticResource Chip}" Content="+1m" Command="{Binding Timer.AddMinutesCommand}" CommandParameter="1" />
                <Button Style="{StaticResource Chip}" Content="+5m" Command="{Binding Timer.AddMinutesCommand}" CommandParameter="5" />
                <Button Style="{StaticResource Chip}" Content="+10m" Command="{Binding Timer.AddMinutesCommand}" CommandParameter="10" Margin="0" />
            </WrapPanel>
        </StackPanel>
    </Grid>
</UserControl>
