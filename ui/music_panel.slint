import { Palette, Type, Space, Radius, Size, Motion } from "theme.slint";
import { IconButton, PrimaryButton, SeekBar, HoverTip, Icon } from "parts.slint";

export struct NowPlaying {
    available: bool,
    playing: bool,
    can-seek: bool,
    title: string,
    artist: string,
    // 0–1
    progress: float,
    position: string,
    duration: string,
}

export enum LyricsMode { status, synced, plain }

export struct LyricLine {
    text: string,
    // Detik dari awal lagu, untuk lompat saat baris diklik.
    seconds: float,
}

// Isi tab Musik: pemutar di kiri, lirik di kanan, garis waktu di bawah.
export component MusicPanel {
    in property <NowPlaying> now;
    in property <image> cover;
    in property <bool> has-cover;
    in property <LyricsMode> lyrics-mode;
    in property <[LyricLine]> lyric-lines;
    // Baris yang sedang dinyanyikan; -1 sebelum baris pertama.
    in property <int> lyric-current: -1;
    // Warna dari cover lagu; tanpa cover berwarna, pakai warna musik dari patpet.conf.
    in property <bool> has-tint;
    in property <color> tint;
    in property <color> tint-card;
    in property <string> lyrics-plain;
    in property <string> lyrics-status;
    callback play-pause();
    callback next();
    callback previous();
    callback seek(float);
    // Lompat ke detik ini (klik baris lirik).
    callback seek-to(float);

    property <color> accent: root.has-tint ? root.tint : Palette.music-progress;
    property <color> card: root.has-tint ? root.tint-card : Palette.raised;
    // Lirik mengikuti lagu, kecuali sebentar setelah pengguna menggulir sendiri.
    property <bool> follow: true;
    // Naik saat lirik harus diposisikan ulang ke baris sekarang.
    property <int> recenter;

    Timer {
        interval: 4s;
        running: !root.follow;
        triggered => {
            root.follow = true;
            root.recenter += 1;
        }
    }

    if !root.now.available: VerticalLayout {
        alignment: center;
        padding: Space.xl;
        // Kolom teks lebih sempit supaya baris terbungkus rata.
        padding-left: Space.xl * 2;
        padding-right: Space.xl * 2;
        spacing: Space.sm;

        Text {
            text: Icon.music;
            font-family: Type.icons;
            font-size: Type.headline;
            color: Palette.faint;
            horizontal-alignment: center;
        }

        Text {
            text: "Spotify belum diputar";
            font-size: Type.title;
            font-weight: Type.semibold;
            color: Palette.text;
            horizontal-alignment: center;
        }

        Text {
            text: "Putar lagu di Spotify desktop untuk melihat kontrol dan liriknya di sini.";
            color: Palette.muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }

    if root.now.available: VerticalLayout {
        padding: Space.lg;
        padding-top: Space.sm;
        spacing: Space.md;

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: Space.lg;

            VerticalLayout {
                width: Size.player-width;
                alignment: center;
                spacing: Space.xs;

                Rectangle {
                    width: Size.cover;
                    height: Size.cover;
                    border-radius: Radius.row;
                    background: Palette.raised;
                    clip: true;

                    if !root.has-cover: Text {
                        text: Icon.music;
                        font-family: Type.icons;
                        font-size: Type.title;
                        color: Palette.faint;
                    }

                    if root.has-cover: Image {
                        width: 100%;
                        height: 100%;
                        source: root.cover;
                    }
                }

                Text {
                    text: root.now.title;
                    font-weight: Type.semibold;
                    color: Palette.text;
                    overflow: elide;
                }

                Text {
                    text: root.now.artist;
                    font-size: Type.caption;
                    color: Palette.muted;
                    overflow: elide;
                }

                HorizontalLayout {
                    alignment: start;
                    spacing: Space.xs;

                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            glyph: Icon.previous;
                            tip: "Lagu sebelumnya";
                            clicked => { root.previous(); }
                        }
                    }

                    PrimaryButton {
                        glyph: root.now.playing ? Icon.pause : Icon.play;
                        tip: root.now.playing ? "Jeda" : "Putar";
                        clicked => { root.play-pause(); }
                    }

                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            glyph: Icon.next;
                            tip: "Lagu berikutnya";
                            clicked => { root.next(); }
                        }
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: root.card;
                animate background { duration: Motion.move; easing: Motion.ease; }
                border-radius: Radius.row;
                clip: true;

                if root.lyrics-mode == LyricsMode.status: Text {
                    width: parent.width - 2 * Space.lg;
                    text: root.lyrics-status;
                    color: Palette.muted;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                if root.lyrics-mode == LyricsMode.synced: lyrics := Flickable {
                    content-height: list.preferred-height;
                    animate content-y { duration: Motion.move; easing: Motion.ease; }
                    flicked => { root.follow = false; }

                    list := VerticalLayout {
                        // Ruang kosong di atas dan bawah supaya baris pertama
                        // dan terakhir pun bisa berada di tengah.
                        padding-top: lyrics.height / 2;
                        padding-bottom: lyrics.height / 2;
                        padding-left: Space.md;
                        padding-right: Space.md;
                        spacing: Space.xs;

                        for line[i] in root.lyric-lines: Rectangle {
                            property <bool> current: i == root.lyric-current;
                            property <int> nudge: root.recenter;

                            function bring-into-view() {
                                if (self.current && root.follow) {
                                    lyrics.content-y = -(self.y + self.height / 2 - lyrics.height / 2);
                                }
                            }
                            changed current => { self.bring-into-view(); }
                            changed nudge => { self.bring-into-view(); }

                            border-radius: Radius.control;
                            background: touch.has-hover ? Palette.raised-hover.with-alpha(0.5) : transparent;
                            min-height: words.preferred-height + Space.xs;

                            words := Text {
                                width: parent.width - 2 * Space.sm;
                                text: line.text;
                                wrap: word-wrap;
                                horizontal-alignment: center;
                                font-size: current ? Type.body : Type.caption;
                                font-weight: current ? Type.semibold : Type.regular;
                                color: current ? root.accent
                                    : touch.has-hover ? Palette.text
                                    : Math.abs(i - root.lyric-current) <= 1 ? Palette.muted
                                    : Palette.faint;
                            }

                            HoverTip {
                                text: "Klik untuk lompat ke baris ini";
                                active: touch.has-hover;
                            }

                            touch := TouchArea {
                                enabled: root.now.can-seek;
                                clicked => {
                                    root.follow = true;
                                    root.seek-to(line.seconds);
                                }
                            }
                        }
                    }
                }

                if root.lyrics-mode == LyricsMode.plain: Flickable {
                    content-height: plain.preferred-height + 2 * Space.md;

                    plain := Text {
                        x: Space.md;
                        y: Space.md;
                        width: parent.width - 2 * Space.md;
                        text: root.lyrics-plain;
                        font-size: Type.caption;
                        color: Palette.muted;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
        }

        VerticalLayout {
            spacing: Space.xs;

            SeekBar {
                fill: root.accent;
                tip: "Klik atau seret untuk pindah ke bagian lain lagu";
                value: root.now.progress;
                enabled: root.now.can-seek;
                seek(f) => { root.seek(f); }
            }

            HorizontalLayout {
                Text {
                    text: root.now.position;
                    font-size: Type.caption;
                    color: Palette.muted;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                Text {
                    text: root.now.duration;
                    font-size: Type.caption;
                    color: Palette.muted;
                }
            }
        }
    }
}
