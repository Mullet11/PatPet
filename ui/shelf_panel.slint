import { Palette, Type, Space, Radius, Size, Motion } from "theme.slint";
import { IconButton, HoverTip, Icon } from "parts.slint";

// Satu file di Shelf.
export struct ShelfItem {
    name: string,
    icon: image,
    has-icon: bool,
}

// Satu isi riwayat clipboard.
export struct ClipItem {
    // Teks yang disalin, atau ukuran gambar ("1920 × 1080").
    text: string,
    image: image,
    is-image: bool,
}

// Deretan kartu yang bergulir ke samping. Roda mouse biasa ikut menggeser
// ke samping karena deretan ini tidak bisa bergulir ke bawah.
component Row inherits TouchArea {
    in property <length> total;

    // Item baru masuk di depan; kembali ke awal supaya terlihat.
    changed total => {
        flick.content-x = 0;
    }

    scroll-event(e) => {
        if (e.delta-y == 0 || flick.content-width <= flick.width) {
            return reject;
        }
        flick.content-x = Math.max(flick.width - flick.content-width, Math.min(0, flick.content-x + e.delta-y));
        accept
    }

    flick := Flickable {
        content-width: Math.max(root.total, self.width);
        content-height: self.height;

        HorizontalLayout {
            spacing: Space.sm;
            alignment: start;

            @children
        }
    }
}

// Tombol bulat kecil di atas kartu.
component SmallButton inherits Rectangle {
    in property <string> tip;
    in property <string> glyph: Icon.close;
    out property <bool> hovered: touch.has-hover;
    callback clicked();

    width: Size.close-hit;
    height: Size.close-hit;
    border-radius: self.width / 2;
    background: touch.has-hover ? Palette.line : Palette.ink;

    Text {
        text: root.glyph;
        font-family: Type.icons;
        font-size: Size.icon-small;
        color: Palette.text;
    }

    HoverTip {
        text: root.tip;
        active: touch.has-hover;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component FileCard inherits Rectangle {
    in property <ShelfItem> item;
    callback open();
    callback remove();
    callback drag();

    // Kartu sudah diseret keluar; pelepasan tombol bukan klik.
    property <bool> dragged;

    width: Size.shelf-card;
    height: Size.shelf-card;
    border-radius: Radius.row;
    background: touch.pressed ? Palette.raised-hover : touch.has-hover ? Palette.raised : transparent;
    animate background { duration: Motion.quick; easing: Motion.ease; }

    touch := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.dragged = false;
            }
        }
        moved => {
            if (self.pressed && !root.dragged
                && (Math.abs(self.mouse-x - self.pressed-x) > Space.xs || Math.abs(self.mouse-y - self.pressed-y) > Space.xs)) {
                root.dragged = true;
                root.drag();
            }
        }
        clicked => {
            if (!root.dragged) {
                root.open();
            }
        }
    }

    VerticalLayout {
        padding: Space.xs;
        padding-top: Space.sm;
        spacing: Space.xs;
        alignment: start;

        HorizontalLayout {
            alignment: center;

            if root.item.has-icon: Image {
                width: Size.shelf-thumb;
                height: Size.shelf-thumb;
                source: root.item.icon;
                image-fit: contain;
            }

            if !root.item.has-icon: Rectangle {
                width: Size.shelf-thumb;
                height: Size.shelf-thumb;
                border-radius: Radius.control;
                background: Palette.raised;
            }
        }

        Text {
            text: root.item.name;
            font-size: Type.caption;
            color: Palette.text;
            horizontal-alignment: center;
            wrap: word-wrap;
            overflow: elide;
            height: Type.caption * 2.8; // dua baris
        }
    }

    HoverTip {
        text: root.item.name + " · seret ke folder untuk memindahkan, klik untuk membuka";
        active: touch.has-hover;
    }

    close := SmallButton {
        x: parent.width - self.width - Space.xs;
        y: Space.xs;
        visible: touch.has-hover || self.hovered;
        tip: "Keluarkan dari Shelf. Filenya tidak dihapus.";
        clicked => { root.remove(); }
    }
}

component ClipCard inherits Rectangle {
    in property <ClipItem> entry;
    callback copy();
    callback keep();

    width: Size.clip-width;
    height: Size.clip-height;
    border-radius: Radius.row;
    background: touch.pressed ? Palette.raised-hover : touch.has-hover ? Palette.raised-hover : Palette.raised;
    animate background { duration: Motion.quick; easing: Motion.ease; }

    touch := TouchArea {
        clicked => { root.copy(); }
    }

    HorizontalLayout {
        padding: Space.xs;
        padding-left: root.entry.is-image ? Space.xs : Space.sm;
        // Sisakan tempat untuk tombol simpan di kanan kartu gambar.
        padding-right: root.entry.is-image ? Size.close-hit + Space.sm : Space.sm;
        spacing: Space.sm;

        if root.entry.is-image: Image {
            width: Size.clip-height - Space.sm;
            source: root.entry.image;
            image-fit: cover;
        }

        Text {
            text: root.entry.text;
            font-size: Type.caption;
            color: root.entry.is-image ? Palette.muted : Palette.text;
            vertical-alignment: center;
            wrap: word-wrap;
            overflow: elide;
        }
    }

    HoverTip {
        text: root.entry.is-image ? "Klik untuk menyalin gambar ini lagi" : "Klik untuk menyalin teks ini lagi";
        active: touch.has-hover;
    }

    if root.entry.is-image: SmallButton {
        x: parent.width - self.width - Space.xs;
        y: (parent.height - self.height) / 2;
        visible: touch.has-hover || self.hovered;
        glyph: Icon.add;
        tip: "Simpan gambar ini sebagai file di Shelf";
        clicked => { root.keep(); }
    }
}

// Tab Shelf: file yang disimpan sementara, lalu riwayat clipboard.
export component ShelfPanel inherits Rectangle {
    in property <[ShelfItem]> items;
    in property <[ClipItem]> clips;
    // File sedang diseret di atas island.
    in property <bool> drop-hover;
    callback open(int);
    callback remove(int);
    callback drag(int);
    callback screenshot();
    callback copy(int);
    callback keep(int);
    callback clear-clips();

    VerticalLayout {
        padding-left: Space.lg;
        padding-right: Space.lg;
        padding-bottom: Space.sm;
        spacing: Space.xs;
        alignment: start;

        HorizontalLayout {
            height: Size.hit;

            Text {
                text: root.items.length == 0 ? "Shelf" : root.items.length + " file di Shelf";
                font-size: Type.body;
                font-weight: Type.semibold;
                color: Palette.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            IconButton {
                glyph: Icon.camera;
                tip: "Ambil screenshot, lalu simpan di Shelf";
                clicked => { root.screenshot(); }
            }
        }

        if root.items.length == 0: Rectangle {
            height: Size.shelf-card;
            border-radius: Radius.row;
            border-width: 1px;
            border-color: root.drop-hover ? Palette.accent : Palette.line;
            background: root.drop-hover ? Palette.raised : transparent;

            VerticalLayout {
                alignment: center;
                spacing: Space.xs;

                Text {
                    text: "Seret file atau folder ke sini";
                    color: root.drop-hover ? Palette.accent : Palette.text;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Filenya tetap di tempat asal sampai kamu menyeretnya ke folder lain.";
                    font-size: Type.caption;
                    color: Palette.faint;
                    horizontal-alignment: center;
                }
            }
        }

        if root.items.length > 0: Row {
            height: Size.shelf-card;
            total: root.items.length * (Size.shelf-card + Space.sm) - Space.sm;

            for item[i] in root.items: FileCard {
                item: item;
                open => { root.open(i); }
                remove => { root.remove(i); }
                drag => { root.drag(i); }
            }
        }

        HorizontalLayout {
            height: Size.close-hit + Space.sm;
            padding-top: Space.sm;

            Text {
                text: "Riwayat clipboard";
                font-size: Type.caption;
                color: Palette.muted;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            if root.clips.length > 0: SmallButton {
                tip: "Hapus riwayat clipboard";
                clicked => { root.clear-clips(); }
            }
        }

        if root.clips.length == 0: Text {
            height: Size.clip-height;
            text: "Teks dan gambar yang kamu salin muncul di sini. Hilang saat PatPet ditutup.";
            font-size: Type.caption;
            color: Palette.faint;
            vertical-alignment: center;
        }

        if root.clips.length > 0: Row {
            height: Size.clip-height;
            total: root.clips.length * (Size.clip-width + Space.sm) - Space.sm;

            for clip[i] in root.clips: ClipCard {
                entry: clip;
                copy => { root.copy(i); }
                keep => { root.keep(i); }
            }
        }
    }
}
