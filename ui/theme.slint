// Satu-satunya sumber nilai desain PatPet.
// Komponen tidak boleh menulis warna, ukuran, atau durasi sendiri; ambil dari sini.
//
// Arah visual: permukaan hitam murni supaya bar menyatu dengan tepi layar
// seperti notch. Warna lain diambil langsung dari palet sprite kucing, jadi
// kucing tetap satu-satunya elemen yang menonjol.

export global Palette {
    // Permukaan
    out property <color> ink: #000000;          // bar dan tray
    out property <color> raised: #171412;       // baris, kolom isian, chip
    out property <color> raised-hover: #231F1C;
    out property <color> line: #2B2623;         // pemisah tipis, garis waktu kosong

    // Teks
    out property <color> text: #FEF5E6;         // krem dari bulu dada kucing
    out property <color> muted: #A6988B;        // teks sekunder, abu hangat
    out property <color> faint: #6E645C;        // petunjuk, placeholder

    // Aksen, masing-masing punya satu tugas
    out property <color> accent: #FDD5B5;       // bulu kucing: aksi utama, tab aktif, charger
    out property <color> on-accent: #1E1612;    // teks di atas aksen
    out property <color> music: #7882C8;        // headphone: semua yang terkait musik
    out property <color> alert: #E65A6E;        // hati: alarm, jatuh tempo, baterai lemah
}

export global Type {
    out property <string> family: "Segoe UI Variable Text";
    out property <string> display: "Segoe UI Variable Display";
    out property <string> icons: "Segoe Fluent Icons";

    // Skala 11 / 13 / 16 / 24 / 40
    out property <length> caption: 11px;
    out property <length> body: 13px;
    out property <length> title: 16px;
    out property <length> headline: 24px;
    out property <length> hero: 40px;

    out property <int> regular: 400;
    out property <int> medium: 500;
    out property <int> semibold: 600;
}

export global Space {
    // Kelipatan 4
    out property <length> xs: 4px;
    out property <length> sm: 8px;
    out property <length> md: 12px;
    out property <length> lg: 16px;
    out property <length> xl: 24px;
}

export global Radius {
    // Makin besar wadahnya, makin besar radiusnya
    out property <length> control: 8px;         // tombol, kolom isian
    out property <length> row: 10px;            // baris catatan, kartu kecil
    out property <length> bar: 16px;            // sudut bawah bar; sudut atas rata seperti notch
    out property <length> tray: 20px;           // tray terbuka
}

export global Size {
    out property <length> bar-height: 34px;
    out property <length> bar-width: 116px;     // tertutup: kucing + jam
    out property <length> bar-width-wide: 300px; // saat hover
    out property <length> tray-width: 420px;
    out property <length> tray-height: 300px;
    out property <length> pet: 32px;            // satu frame sprite 32x32
    out property <length> icon: 14px;
    out property <length> hit: 28px;            // area klik minimum tombol ikon
}

export global Motion {
    // Satu kurva untuk semua gerak, dua durasi
    out property <duration> quick: 120ms;       // hover, tekan
    out property <duration> move: 220ms;        // bar melebar, tray, pindah tab
    out property <easing> ease: cubic-bezier(0.2, 0.8, 0.2, 1);
}
